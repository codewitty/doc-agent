# Copy to .env and export, or set in your shell. Everything is optional for
# local development: the defaults run fully offline.

# sqlite:///path or a postgresql:// URL
DATABASE_URL=sqlite:///doc-agent.db

# Set to use the real model and embeddings; unset runs the keyless demo
OPENAI_API_KEY=
# heuristic | openai, and hashing | openai. Default follows OPENAI_API_KEY.
DOC_AGENT_MODEL=
DOC_AGENT_EMBEDDER=

# token:user pairs. Unset in dev means alice-dev-token and bob-dev-token.
DOC_AGENT_TOKENS=
# Users that get the fixture documents on startup
DOC_AGENT_SEED_USERS=alice

# dev | test | prod. prod refuses to start without DOC_AGENT_TOKENS.
DOC_AGENT_ENV=dev

# Only for the Postgres contract tests
DATABASE_URL_TEST=
